# Copy to .env (git-ignored) and fill in. Never commit real keys, and never
# show them on screen (the video) or let them reach a log, report or hook output.

# Required for [API: OpenRouter] steps: the Decisions API adapter (Jev 1.14 and
# the other decision models) and any judge served through OpenRouter.
# Code/test/paper steps do NOT need it.
OPENROUTER_API_KEY=

# Hugging Face read token: pulls the Gemma 4 31B-it judge weights on the H100 (R5).
HF_READ_TOKEN=

# Optional: Claude models via the Anthropic API (see memory/decision-llm-routing.md).
ANTHROPIC_API_KEY=
